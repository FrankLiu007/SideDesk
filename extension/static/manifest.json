{
  "manifest_version": 3,
  "name": "SideDesk",
  "version": "0.2.0",
  "description": "打开是待办。点一条后，左边是原帖，右边做这一条。",
  "permissions": ["sidePanel", "tabs", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "*://*.reddit.com/*",
    "*://*.bilibili.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.v2ex.com/*",
    "*://*.zhihu.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 SideDesk",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
