# Copy to .env in the repository root. Do not commit the real file.

# SQLite file. Relative paths are from the repository root.
DESK_DATABASE=data/desk.db

# Daily refresh hour in DESK_TIMEZONE.
DESK_REFRESH_HOUR=8
DESK_TIMEZONE=Asia/Shanghai

# Optional markdown file. Imported once on startup when the database has no leads.
# SEED_PATH=

# Reddit script app: https://www.reddit.com/prefs/apps
# Leave blank to keep manual leads and reply logging. Search and comment refresh stay off.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
