# Copy to marketing-desk/.env. Do not commit the real file.

# SQLite file. Relative paths are from the marketing-desk directory.
DESK_DATABASE=data/desk.db

# Daily refresh hour in DESK_TIMEZONE. The Today page is the reminder.
DESK_REFRESH_HOUR=8
DESK_TIMEZONE=Asia/Shanghai

# Reddit script app: https://www.reddit.com/prefs/apps
# Leave blank to keep manual leads and reply logging. Search and comment refresh stay off.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
